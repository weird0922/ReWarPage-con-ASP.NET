@model Categoria

@{
    ViewData["Title"] = "Eliminar categoría";
}

<h1>Eliminar categoría</h1>

<h3>¿Estás seguro que quieres desactivar esta categoría?</h3>

<p class="text-danger">
    Al desactivarla, ya no se podrán publicar prendas nuevas en la categoría "<strong>@Model.Nombre</strong>".
    Las prendas ya publicadas en ella no se ven afectadas.
</p>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Descripcion)</dt>
    <dd class="col-sm-10">@Model.Descripcion</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Desactivar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
