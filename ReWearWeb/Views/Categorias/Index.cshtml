@model IEnumerable<Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<h1>Categorías</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nueva</a>
</p>

@if (!Model.Any())
{
    <p>No hay categorías registradas todavía.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                <th>@Html.DisplayNameFor(m => m.Descripcion)</th>
                <th>@Html.DisplayNameFor(m => m.Estado)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <form asp-action="ToggleEstado" asp-route-id="@item.Id" method="post" class="d-inline">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           id="estado-@item.Id"
                                           onchange="this.form.submit()" />
                                    <label class="form-check-label" for="estado-@item.Id">
                                        Inactiva (activar)
                                    </label>
                                </div>
                            </form>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        @if (item.Estado)
                        {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
