@model IEnumerable<ReWearWeb.Models.Prenda>

@{
    ViewData["Title"] = "Prendas disponibles";
}

<div class="container py-5">
    <header class="mb-5 text-center">
        <h1 class="fw-light mb-2" style="letter-spacing: 0.05em;">PRENDAS DISPONIBLES</h1>
        <p class="text-muted">Ropa con historia, lista para una segunda vida.</p>
    </header>

    <div class="row g-4">
        @foreach (var prenda in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="card h-100 border-0 shadow-sm overflow-hidden" style="transition: transform .2s ease;">
                    <div class="d-flex align-items-center justify-content-center bg-light" style="height: 240px;">
                        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#adb5bd" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>
                        </svg>
                    </div>
                    <div class="card-body px-4 py-4 d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <span class="badge rounded-pill text-bg-light text-secondary border fw-normal px-3">
                                @prenda.Categoria.Nombre
                            </span>
                            <strong class="fs-4" style="color: #2c3e50;">S/ @prenda.Precio.ToString("0.00")</strong>
                        </div>

                        <h5 class="card-title mb-2 fw-medium">@prenda.Titulo</h5>

                        <p class="card-text text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @prenda.Descripcion
                        </p>

                        <ul class="list-unstyled small text-secondary mb-3">
                            <li class="mb-1"><span class="text-muted">Talla:</span> @prenda.Talla</li>
                            <li class="mb-1"><span class="text-muted">Estado:</span> @prenda.Estado</li>
                            @if (!string.IsNullOrEmpty(prenda.Marca))
                            {
                                <li class="mb-1"><span class="text-muted">Marca:</span> @prenda.Marca</li>
                            }
                            @if (!string.IsNullOrEmpty(prenda.Color))
                            {
                                <li><span class="text-muted">Color:</span> @prenda.Color</li>
                            }
                        </ul>

                        <footer class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white small" style="width:32px;height:32px;background:#b08968;">
                                    @prenda.Vendedor.Nombre[0]
                                </div>
                                <small class="text-muted">@prenda.Vendedor.Nombre @prenda.Vendedor.Apellidos.Split(' ')[0]</small>
                            </div>
                            <small class="text-muted">@prenda.FechaPublicacion.ToString("dd MMM yyyy")</small>
                        </footer>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-6">
            <p class="text-muted">No hay prendas disponibles por el momento.</p>
        </div>
    }
</div>
