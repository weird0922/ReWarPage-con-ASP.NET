@model IEnumerable<ReWearWeb.Models.Prenda>

@{
    ViewData["Title"] = "Shop";
}

<div class="rewear-page-header">
    <div class="rewear-section-wrap">
        <h1 class="rewear-page-title">Prendas disponibles</h1>
        <p class="rewear-page-subtitle">Ropa con historia, lista para una segunda vida.</p>
    </div>
</div>

<div class="rewear-section-wrap rewear-catalog-wrap">
    <div class="row g-4">
        @foreach (var prenda in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="rewear-prenda-card">
                    <div class="rewear-prenda-img">
                        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--rewear-zinc-500)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>
                        </svg>
                    </div>
                    <div class="rewear-prenda-body">
                        <div class="rewear-prenda-meta">
                            <span class="rewear-prenda-category">
                                @prenda.Categoria.Nombre
                            </span>
                            <div class="rewear-prenda-price">S/ @prenda.Precio.ToString("0.00")</div>
                        </div>

                        <h5 class="rewear-prenda-title">@prenda.Titulo</h5>

                        <p class="rewear-prenda-desc">
                            @prenda.Descripcion
                        </p>

                        <ul class="rewear-prenda-details">
                            <li><strong>Talla:</strong> @prenda.Talla</li>
                            <li><strong>Estado:</strong> @prenda.Estado</li>
                            @if (!string.IsNullOrEmpty(prenda.Marca))
                            {
                                <li><strong>Marca:</strong> @prenda.Marca</li>
                            }
                            @if (!string.IsNullOrEmpty(prenda.Color))
                            {
                                <li><strong>Color:</strong> @prenda.Color</li>
                            }
                        </ul>

                        <footer class="rewear-prenda-footer">
                            <div class="rewear-seller-info">
                                <div class="rewear-seller-avatar">
                                    @prenda.Vendedor.Nombre[0]
                                </div>
                                <span class="rewear-seller-name">@prenda.Vendedor.Nombre @prenda.Vendedor.Apellidos.Split(' ')[0]</span>
                            </div>
                            <span class="rewear-prenda-date">@prenda.FechaPublicacion.ToString("dd MMM yyyy")</span>
                        </footer>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="rewear-empty-state">
            <p>No hay prendas disponibles por el momento.</p>
        </div>
    }
</div>
